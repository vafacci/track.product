# Copy to .env and fill in. Only GEMINI_* and SMTP_* are needed for the
# Gemini fallback and e-mail alerts; everything else has sensible defaults.

# --- Storage ---
DATABASE_PATH=./data/tracker.db

# --- App ---
# Public URL of the web UI, used for links in alert e-mails.
APP_URL=http://localhost:3000
# Optional: if set, the web UI asks for this password.
APP_PASSWORD=

# --- Currency ---
BASE_CURRENCY=DKK
# ECB-based rates, no key needed.
FX_API_URL=https://api.frankfurter.dev/v1

# --- Price checks ---
CHECK_INTERVAL_HOURS=6
# Random extra delay per check, so we don't hit shops on the exact hour.
CHECK_JITTER_MINUTES=30
# Minimum seconds between two requests to the same domain.
DOMAIN_MIN_DELAY_SECONDS=20
# Re-check after this many minutes if the price moved more than 50 %.
SANITY_RECHECK_MINUTES=5
# Use a headless browser (Playwright) when a plain HTTP fetch is blocked.
PLAYWRIGHT_ENABLED=true

# --- Gemini (fallback extraction + "same product?" check) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- E-mail alerts (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
