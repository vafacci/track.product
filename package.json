{
  "name": "track.product",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "next dev",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker/index.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start\" \"npm:worker\"",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "browser:install": "playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "probe": "node --env-file-if-exists=.env --import tsx scripts/probe.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "playwright": "^1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
